{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antisismo.app/schemas/signed-alert.schema.json",
  "title": "SignedAlert",
  "description": "Payload de push firmado con Ed25519 (§7.2). La firma cubre la cadena canónica v1. level=DRILL identifica simulacros (firmado, nunca canal crítico — ADR-0002).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "alert_id", "level", "event", "instruction", "voice", "iat_ms", "exp_ms", "server_time_ms", "kid", "sig"],
  "properties": {
    "v": { "const": 1 },
    "alert_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "level": { "enum": ["CRITICAL", "INFORMATIVE", "DRILL"] },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "magnitude", "mag_type", "time_utc_ms", "place", "lon", "lat", "depth_km",
        "mmi_estimated_regional", "mmi_range", "tsunami", "solution_status", "revision_seq", "tea_regional_seconds"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "enum": ["EARTHQUAKE", "TSUNAMI", "VOLCANO", "FLOOD", "LANDSLIDE", "WILDFIRE", "CIVIL"] },
        "magnitude": { "type": "number", "minimum": -2, "maximum": 10 },
        "mag_type": { "type": "string", "pattern": "^[A-Za-z_]{1,8}$" },
        "time_utc_ms": { "type": "integer", "minimum": 946684800000, "maximum": 32503680000000 },
        "place": { "type": "string", "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F<>]*$" },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "depth_km": { "type": "number", "minimum": -100, "maximum": 1000 },
        "mmi_estimated_regional": { "type": ["number", "null"], "minimum": 1, "maximum": 12 },
        "mmi_range": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "prefixItems": [{ "type": "number", "minimum": 1, "maximum": 12 }, { "type": "number", "minimum": 1, "maximum": 12 }], "items": false, "minItems": 2 }
          ]
        },
        "tsunami": { "type": "boolean" },
        "solution_status": { "enum": ["automatic", "reviewed"] },
        "revision_seq": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "tea_regional_seconds": { "type": ["integer", "null"], "minimum": 0, "maximum": 600 }
      }
    },
    "instruction": { "enum": ["DROP_COVER_HOLD_ON", "EVACUATE_HIGH_GROUND", "FLOOD_MOVE_AWAY", "FOLLOW_AUTHORITIES"] },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speak_name"],
      "properties": { "speak_name": { "type": "boolean" } }
    },
    "iat_ms": { "type": "integer", "minimum": 946684800000 },
    "exp_ms": { "type": "integer", "minimum": 946684800000 },
    "server_time_ms": { "type": "integer", "minimum": 946684800000 },
    "kid": { "type": "string", "pattern": "^k-[a-z0-9-]{1,32}$" },
    "sig": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
