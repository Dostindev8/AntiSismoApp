# ─────────────────────────────────────────────────────────────────────────────
# AntiSismo — variables de entorno (placeholders; NUNCA valores reales en git)
# Cada variable marcada con [BLK-xx] depende de un tercero (ver BLOCKERS.md).
# «reservada» = documentada para una fase futura; ningún binario la lee todavía.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno: dev | staging | production. Solo «dev» permite clave de firma efímera.
ANTISISMO_ENV=dev

# Región activa (config en packages/config/regions/<REGION>.yaml)
ANTISISMO_REGION=DO
ANTISISMO_CONFIG_DIR=packages/config

# Camino crítico — Redis Streams (vacío o caído ⇒ fallback automático a cola en memoria)
REDIS_URL=redis://localhost:6379

# alertd (services/delivery/cmd/alertd)
DELIVERY_WORKERS=32
METRICS_ADDR=127.0.0.1:9101

# Firma Ed25519 de alertas [BLK-03]
# Producción: inyectar desde el gestor de secretos/KMS en tiempo de despliegue, nunca en archivos.
SIGNING_KID=k-2026-09
SIGNING_SEED_B64=
# Clave de respaldo (rotación); si la principal falla se firma con esta.
SIGNING_BACKUP_KID=
SIGNING_BACKUP_SEED_B64=
# reservada: referencia a clave en KMS/HSM cuando se integre el firmador remoto
ALERT_SIGNING_KMS_KEY_ID=

# Push FCM HTTP v1 [BLK-01] (credenciales por Application Default Credentials)
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# APNs directo [BLK-02] (reservadas)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=app.antisismo.mobile

# Ingesta — hosts permitidos (la allowlist efectiva está en el código y en regions/*.yaml)
INGEST_ALLOWED_HOSTS=earthquake.usgs.gov,www.seismicportal.eu

# Servicios de valor, NO camino crítico (F4, reservadas)
DATABASE_URL=postgres://antisismo:antisismo@localhost:5432/antisismo
API_PORT=8080
API_JWT_ISSUER=antisismo-api
API_JWT_AUDIENCE=antisismo-mobile
API_JWT_PUBLIC_KEY_PATH=
API_CORS_ORIGINS=http://localhost:3000

# Observabilidad [BLK-06] (reservadas)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# App móvil (se pasan con --dart-define, no por .env):
#   EMERGENCY_TEST_NUMBER=5550100   número ficticio para builds debug/staging (nunca un número real)
#   MAP_LINK_BASE=https://www.google.com/maps/search/?api=1&query=
