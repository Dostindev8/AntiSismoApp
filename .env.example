# ─────────────────────────────────────────────────────────────────────────────
# AntiSismo — variables de entorno (placeholders; NUNCA valores reales en git)
# Cada variable marcada con [BLK-xx] depende de un tercero (ver BLOCKERS.md).
# «reservada» = documentada para una fase futura; ningún binario la lee todavía.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno: dev | staging | production. Solo «dev» permite clave de firma efímera.
ANTISISMO_ENV=dev

# Región activa (config en packages/config/regions/<REGION>.yaml)
ANTISISMO_REGION=DO
ANTISISMO_CONFIG_DIR=packages/config

# Camino crítico — Redis Streams (vacío o caído ⇒ fallback automático a cola en memoria)
REDIS_URL=redis://localhost:6379

# alertd (services/delivery/cmd/alertd)
DELIVERY_WORKERS=32
METRICS_ADDR=127.0.0.1:9101

# Firma Ed25519 de alertas [BLK-03]
# Producción: inyectar desde el gestor de secretos/KMS en tiempo de despliegue, nunca en archivos.
SIGNING_KID=k-2026-09
SIGNING_SEED_B64=
# Clave de respaldo (rotación); si la principal falla se firma con esta.
SIGNING_BACKUP_KID=
SIGNING_BACKUP_SEED_B64=
# reservada: referencia a clave en KMS/HSM cuando se integre el firmador remoto
ALERT_SIGNING_KMS_KEY_ID=

# Push FCM HTTP v1 [BLK-01] (credenciales por Application Default Credentials)
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# APNs directo [BLK-02] (reservadas)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=app.antisismo.mobile

# Ingesta — hosts permitidos (la allowlist efectiva está en el código y en regions/*.yaml)
INGEST_ALLOWED_HOSTS=earthquake.usgs.gov,www.seismicportal.eu

# Servicios de valor, NO camino crítico (F4, reservadas)
DATABASE_URL=postgres://antisismo:antisismo@localhost:5432/antisismo
API_PORT=8080
API_JWT_ISSUER=antisismo-api
API_JWT_AUDIENCE=antisismo-mobile
API_JWT_PUBLIC_KEY_PATH=
API_CORS_ORIGINS=http://localhost:3000
# services/api (cuentas; fuera del camino crítico). Esquema completo y límites en services/api/src/config/env.ts
API_PUBLIC_ORIGIN=http://localhost:8080
API_WEB_ORIGIN=http://localhost:3000
API_TRUST_PROXY=loopback
API_MONGO_URI=mongodb://localhost:27017/antisismo
API_JWT_KID=api-dev
API_HIBP_ENABLED=true
# Opcional: sin Redis o caído ⇒ rate limiting en memoria local (modo degradado reportado en /readyz)
API_REDIS_URL=
# Producción [BLK-19]: PEM PKCS8/SPKI Ed25519 montados desde el gestor de secretos (dev usa clave efímera)
API_JWT_PRIVATE_KEY_PATH=
# 32 bytes en base64 para AES-256-GCM de campos sensibles (obligatoria en producción)
API_FIELD_KEY_B64=
# Google OAuth 2.0 + PKCE [BLK-19] (sin ambas variables /v1/auth/google/* responde 503)
API_GOOGLE_CLIENT_ID=
API_GOOGLE_CLIENT_SECRET=
# Versión vigente de términos y privacidad (fecha AAAA-MM-DD); cambiarla obliga a re-aceptar en /account
API_TERMS_VERSION=2026-10-03
# Límite propio para csrf/refresh/logout (se usan en cada recarga; no comparten cupo con el login)
API_RATE_SESSION_MAX=300
# Solo `pnpm --filter @antisismo/api dev:memory`: buzón de correo de pruebas en loopback
API_E2E_OUTBOX_PORT=8091
# Con la web como proxy same-origin (ADR 0008), en producción:
#   API_PUBLIC_ORIGIN=https://<dominio-web>/api   (el callback de Google pasa por la web y conserva las cookies)
#   API_TRUST_PROXY=<saltos reales>               (para que el rate limit vea la IP del cliente, no la del proxy)

# Web (apps/web) — origen público del API; en producción debe ser https (validado con zod)
NEXT_PUBLIC_API_ORIGIN=
# Solo servidor: destino de la reescritura /api/v1/* → <origen>/v1/*. https en producción (http solo a loopback).
# Vacío ⇒ las cuentas muestran «no disponibles» (503 controlado); alertas y emergencias siguen funcionando.
API_INTERNAL_ORIGIN=

# Observabilidad [BLK-06] (reservadas)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# App móvil (se pasan con --dart-define, no por .env):
#   EMERGENCY_TEST_NUMBER=5550100   número ficticio para builds debug/staging (nunca un número real)
#   MAP_LINK_BASE=https://www.google.com/maps/search/?api=1&query=
